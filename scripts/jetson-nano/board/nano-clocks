#!/bin/sh
# Pin CPU/GPU clocks to the values in /etc/default/nano-clocks (runs after jetson_clocks).
# The OC kernel's tables go higher than stock; boot always lands on these values, so a crash under an
# experimental clock reboots into whatever is configured here.
. /etc/default/nano-clocks
G=/sys/devices/57000000.gpu/devfreq/57000000.gpu
for pass in 1 2; do  # min/max ordering differs when raising vs lowering; two passes settle both
    for c in /sys/devices/system/cpu/cpu[0-3]/cpufreq; do
        echo "$CPU_KHZ" > "$c/scaling_max_freq" 2>/dev/null
        echo "$CPU_KHZ" > "$c/scaling_min_freq" 2>/dev/null
    done
    echo "$GPU_HZ" > "$G/max_freq" 2>/dev/null
    echo "$GPU_HZ" > "$G/min_freq" 2>/dev/null
done
[ -w /sys/devices/pwm-fan/target_pwm ] && echo 255 > /sys/devices/pwm-fan/target_pwm
echo "nano-clocks: cpu $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq) kHz, gpu $(cat $G/cur_freq) Hz"
